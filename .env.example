# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# LLM provider for regenerating fixtures/. NOT needed to reproduce results:
# `make eval` runs entirely from the committed fixture set with no key at all.

# Google AI Studio - free tier, no card. https://aistudio.google.com
# Comma-separated. Free quotas are per key, so extra keys extend the daily ceiling
# and the provider rotates automatically when one is exhausted.
GEMINI_API_KEYS=key_one,key_two
RECURA_GEMINI_MODEL=gemini-2.5-flash

# Anthropic (optional, paid) - used for the provider-comparison ablation.
# ANTHROPIC_API_KEY=sk-ant-...
# RECURA_LLM_EFFORT=low

# Force a provider: anthropic | gemini | null
# RECURA_LLM_PROVIDER=gemini

# Razorpay TEST MODE ONLY. A live key is refused at construction.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
